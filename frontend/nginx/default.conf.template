# 운영 스토어 서버(Railway frontend 서비스). 개발 서버 vite.config.ts의 프록시와 같은 규칙으로 화면과 API를 나눈다.
#  - API 경로라도 브라우저가 페이지(Accept: text/html)를 요청하면 React 화면(index.html)을 준다.
#  - API와 상담 WebSocket은 Railway 내부망의 백엔드(BACKEND_URL)로 전달한다. 백엔드에는 공개 주소가 없다.
# ${PORT}, ${BACKEND_URL}, ${NGINX_LOCAL_RESOLVERS}는 컨테이너가 시작될 때 nginx 이미지가 환경변수로 채운다.

map $http_accept $wants_page {
    default 0;
    "~text/html" 1;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

# Railway 앞단이 HTTPS를 처리하고 알려 준 원래 프로토콜. 앞단 없이 직접 접속하면 이 서버의 프로토콜을 쓴다.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

server {
    listen ${PORT};
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 백엔드가 다시 배포되면 내부 주소가 바뀌므로, 시작할 때 한 번이 아니라 요청할 때 이름을 다시 찾는다.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $backend ${BACKEND_URL};

    # 잠든 백엔드는 연결을 늦게 받거나 거절한다. 오래 붙잡지 않고 502·504로 답하면 화면이 깨어날 때까지 다시 확인한다.
    proxy_connect_timeout 10s;

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        # 토스 결제창 팝업을 허용한다. 개발 서버와 같은 값이다.
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    }

    # 파일 이름에 내용 해시가 붙은 빌드 결과라 오래 캐시해도 된다.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ~ ^/(orders|payment-attempts|products|payments|payment-config|chat|admin|me/) {
        if ($wants_page) {
            rewrite ^ /index.html last;
        }
        proxy_pass $backend;
        # 백엔드가 원래 주소(스토어 도메인, https)를 알도록 넘긴다.
        # Spring은 X-Forwarded-Proto를 받으면 포트를 기본값으로 바꾸므로, 포트까지 담긴 X-Forwarded-Host도 넘긴다.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 상담 실시간 알림(STOMP over WebSocket). 백엔드의 같은 출처 검사가 원래 주소를 보도록 위와 같은 헤더를 넘긴다.
    location = /ws {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
